# Writes a header with the git state of the COCOA source tree.
# Run at every build (see CMakeLists.txt) so that RunInfo records the commit the
# executable was actually built from, not the one present at configure time.
#
# Inputs: SOURCE_DIR (directory inside the git work tree), OUTPUT (header path).

find_package(Git QUIET)

set(COCOA_GIT_COMMIT "unknown")
set(COCOA_GIT_DESCRIBE "unknown")
set(COCOA_GIT_DIRTY -1)

if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse HEAD
                  OUTPUT_VARIABLE _commit RESULT_VARIABLE _result
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(_result EQUAL 0)
    set(COCOA_GIT_COMMIT "${_commit}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" describe --always --dirty --tags
                    OUTPUT_VARIABLE _describe
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    set(COCOA_GIT_DESCRIBE "${_describe}")
    # Uncommitted changes to tracked files; untracked files are ignored.
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE _status
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_status STREQUAL "")
      set(COCOA_GIT_DIRTY 0)
    else()
      set(COCOA_GIT_DIRTY 1)
    endif()
  endif()
endif()

set(_content "// Generated by cmake/CocoaGitVersion.cmake. Do not edit.
#pragma once
#define COCOA_GIT_COMMIT \"${COCOA_GIT_COMMIT}\"
#define COCOA_GIT_DESCRIBE \"${COCOA_GIT_DESCRIBE}\"
#define COCOA_GIT_DIRTY ${COCOA_GIT_DIRTY}
")

# Only touch the header when its content changes, to avoid needless rebuilds.
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _old_content)
else()
  set(_old_content "")
endif()
if(NOT _content STREQUAL _old_content)
  file(WRITE "${OUTPUT}" "${_content}")
endif()
