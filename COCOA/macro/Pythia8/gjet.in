/generator/select pythia8
/generator/pythia8/verbose 0
/generator/pythia8/QuarkGluon 22122212

# Prompt-photon pp sample for photon + jet studies.
/generator/pythia8/read Beams:eCM = 14000.
/generator/pythia8/read Beams:idA = 2212
/generator/pythia8/read Beams:idB = 2212

# Hard-process lower cut. This is the minimum invariant pT of the prompt-photon
# subprocess, not the final-state photon pT after showering.
/generator/pythia8/read PhaseSpace:pTHatMin = 50.
/generator/pythia8/read PromptPhoton:qg2qgamma = on
/generator/pythia8/read PromptPhoton:qqbar2ggamma = on
/generator/pythia8/read Next:numberShowInfo = 0
/generator/pythia8/read Next:numberShowProcess = 0
/generator/pythia8/read Next:numberShowEvent = 0

/generator/pythia8/init 2212 2212 14000.

/tracking/storeTrajectory 1

/run/beamOn 100
